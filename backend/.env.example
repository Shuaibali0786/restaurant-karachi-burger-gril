# Copy this file to .env and fill in the real values. NEVER commit .env.

# Database (Neon, Singapore). Pooled URL for the app, direct URL for Alembic migrations.
# Use the "postgresql+psycopg://" prefix (not "postgresql://").
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require
# Neon branch "test", used only by pytest. It must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-yyyy-pooler.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require

# Auth
# Generate with: uv run python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_DAYS=7
# Set false only if your browser rejects Secure cookies on http://localhost
COOKIE_SECURE=true

# First admin (used once by: uv run python -m app.cli create-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-of-12-plus-chars
ADMIN_NAME=Restaurant Admin

# Web
# Comma-separate for more than one origin. Used for CORS and the Origin check.
FRONTEND_URL=http://localhost:3000
# true in production behind Vercel/Render (reads the client IP from X-Forwarded-For)
TRUST_PROXY=false
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true
FREE_DELIVERY_THRESHOLD=1500
LOG_LEVEL=info
