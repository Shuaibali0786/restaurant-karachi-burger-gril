# Public URL of the deployed site, used for absolute Open Graph/share image links.
# Not a secret. Leave unset locally (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Backend API (FastAPI). The browser calls /api/* on this site and Next.js forwards it here
# (see next.config.ts). Server-side pages call it directly. Not a secret.
NEXT_PUBLIC_API_URL=http://localhost:8000
